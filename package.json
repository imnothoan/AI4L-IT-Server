{
  "name": "intelligence-test-server",
  "version": "1.0.0",
  "description": "Computer Adaptive Testing Server with Advanced Proctoring",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config jest.config.json --testMatch='**/*.e2e.test.ts'",
    "test:unit": "jest --config jest.config.json --testMatch='**/*.test.ts' --testPathIgnorePatterns='e2e'",
    "load:test": "artillery run load-test-advanced.yaml",
    "load:quick": "artillery quick --count 100 --num 10 http://localhost:3000/api/health",
    "seed": "tsx src/scripts/seed_user.ts",
    "gen:questions": "tsx src/scripts/generate_questions.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:migrate": "echo 'Run migrations manually via Supabase dashboard'",
    "db:seed": "npm run seed"
  },
  "keywords": [
    "CAT",
    "IRT",
    "adaptive-testing",
    "proctoring",
    "education"
  ],
  "author": "Intelligence Test Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.1.3",
    "@supabase/supabase-js": "^2.38.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cat": "^1.0.0",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "artillery": "^2.0.3",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}